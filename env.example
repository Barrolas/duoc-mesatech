# Copiar a .env (no versionar). Valores ficticios / placeholders.
# IDs reales de Entra y contraseñas: canal privado del equipo.
# Frontend CRA también usa frontend/.env.example.

# =============================================================================
# Microsoft Entra ID (BFF + MS como Resource Server; SPA MSAL)
# =============================================================================
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_SPA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_ISSUER_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
ENTRA_AUDIENCE=${ENTRA_API_CLIENT_ID}

# =============================================================================
# Frontend (CRA: prefijo REACT_APP_) — o usar frontend/.env
# =============================================================================
REACT_APP_ENTRA_CLIENT_ID=${ENTRA_SPA_CLIENT_ID}
REACT_APP_ENTRA_TENANT_ID=${ENTRA_TENANT_ID}
REACT_APP_ENTRA_API_SCOPE=api://${ENTRA_API_CLIENT_ID}/access_as_user
# Local: BFF. Cloud: Invoke URL del HTTP API (sin / final).
# REACT_APP_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
REACT_APP_API_BASE_URL=http://localhost:8080

# =============================================================================
# BFF
# =============================================================================
MS_SOLICITUDES_URL=http://localhost:8081
MS_CATALOGO_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# PostgreSQL — credenciales de aplicación (local Docker o usuario RDS de app)
# Local Docker: ver infra/docker-compose.yml (postgres:16).
# AWS: endpoints en Inventario_AWS_EP2.md; master mesatech_admin solo fuera de git.
# =============================================================================
POSTGRES_USER=mesatech
POSTGRES_PASSWORD=mesatech_cambiar

# =============================================================================
# ms-solicitudes — datasource
# En origin/feature/skarlett-consumidor:
#   spring.datasource.url=${SOLICITUDES_DATASOURCE_URL:jdbc:postgresql://localhost:5433/mesatech_solicitudes}
# =============================================================================
SOLICITUDES_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mesatech_solicitudes
# AWS (ejemplo ficticio de forma; host real = inventario Ari):
# SOLICITUDES_DATASOURCE_URL=jdbc:postgresql://mesatech-ep2-solicitudes.CG33A3YT7NS0.REPLACE.us-east-1.rds.amazonaws.com:5432/mesatech_solicitudes

# =============================================================================
# ms-solicitudes — RabbitMQ consumidor (código en origin/feature/skarlett-consumidor)
# Placeholders reales del application.properties: RABBITMQ_HOST, PORT, USER, PASSWORD, VHOST, DECLARE
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mesatech
RABBITMQ_PASSWORD=mesatech_cambiar
RABBITMQ_VHOST=mesatech
# Local/dev: true declara exchange/cola/binding. En EC2 B (Ari ya creó recursos): false
RABBITMQ_DECLARE=true

# Nombres fijos hoy en mesatech.rabbitmq.* del consumidor (no van por env salvo override Spring):
#   exchange    = catalogo.exchange
#   queue       = solicitudes.catalogo.queue
#   routing-key = categoria.creada
# AWS app user consumidor: solicitudes_consumidor (inventario Ari)

# =============================================================================
# ms-catalogo — datasource + Rabbit publicador (EP2)
# Local: .env raíz. AWS EC2 A: infra/ec2/ms-catalogo.env (plantilla sin secretos abajo)
# =============================================================================
CATALOGO_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mesatech_catalogo
# AWS: jdbc:postgresql://mesatech-ep2-catalogo.<id>.us-east-1.rds.amazonaws.com:5432/mesatech_catalogo

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech
RABBITMQ_USER=mesatech
RABBITMQ_PASSWORD=mesatech_cambiar
RABBITMQ_DECLARE=true
# AWS EC2 A → broker: RABBITMQ_HOST=172.31.18.133, USER=catalogo_publicador, DECLARE=false