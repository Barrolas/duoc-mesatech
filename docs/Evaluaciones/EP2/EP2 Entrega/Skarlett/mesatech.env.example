# Copiar a /home/ubuntu/mesatech.env en la EC2 B (mesatech-ep2-solicitudes).
# No subir el archivo real. Contraseñas: canal privado de Ari.

export ENTRA_ISSUER_URI="https://login.microsoftonline.com/<TENANT_ID>/v2.0"
export ENTRA_AUDIENCE="<API_CLIENT_ID>"

export POSTGRES_USER="mesatech_admin"
export POSTGRES_PASSWORD="<password-rds-solicitudes>"
export SOLICITUDES_DATASOURCE_URL="jdbc:postgresql://mesatech-ep2-solicitudes.cg33a3yt7ns0.us-east-1.rds.amazonaws.com:5432/mesatech_solicitudes"

# Usuario de aplicación del consumidor. La cola ya existe: no declararla desde el JAR.
export RABBITMQ_HOST="172.31.18.133"
export RABBITMQ_PORT="5672"
export RABBITMQ_USER="solicitudes_consumidor"
export RABBITMQ_PASSWORD="<password-rabbitmq-consumidor>"
export RABBITMQ_VHOST="mesatech"
export RABBITMQ_DECLARE="false"
