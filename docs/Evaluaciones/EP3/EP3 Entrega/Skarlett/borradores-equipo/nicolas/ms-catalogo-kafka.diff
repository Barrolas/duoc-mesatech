+package cl.duoc.mesatech.catalogo.messaging.kafka;
+
+import jakarta.validation.ConstraintViolation;
+import jakarta.validation.Validation;
+import jakarta.validation.Validator;
+import org.junit.jupiter.api.Test;
+
+import java.time.Instant;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PrioridadEventosValidationTest {
+
+    private final Validator validator = Validation.buildDefaultValidatorFactory().getValidator();
+
+    @Test
+    void aceptaContratoPrioridadValidoDeGiannina() {
+        PrioridadRenombradaEvent valido = new PrioridadRenombradaEvent(
+                "e6f7a8b9-0123-4cde-a012-3456789abcde",
+                "catalogo.prioridad.renombrada",
+                Instant.parse("2026-11-24T21:14:00Z"),
+                2L,
+                "Alta",
+                "Crítica operacional",
+                4
+        );
+        assertTrue(validator.validate(valido).isEmpty());
+    }
+
+    @Test
+    void rechazaContratoPrioridadInvalidoPorNombreNuevoVacio() {
+        PrioridadRenombradaEvent invalido = new PrioridadRenombradaEvent(
+                "f7a8b9c0-1234-4def-8123-456789abcdef",
+                "catalogo.prioridad.renombrada",
+                Instant.parse("2026-11-24T21:14:00Z"),
+                2L,
+                "Alta",
+                "",
+                4
+        );
+        Set<ConstraintViolation<PrioridadRenombradaEvent>> violaciones = validator.validate(invalido);
+        assertEquals(1, violaciones.size());
+        ConstraintViolation<PrioridadRenombradaEvent> v = violaciones.iterator().next();
+        assertEquals("nombreNuevo", v.getPropertyPath().toString());
+    }
+
+    @Test
+    void rechazaUuidNoV4() {
+        PrioridadRenombradaEvent invalido = new PrioridadRenombradaEvent(
+                "f7a8b9c0-1234-1def-8123-456789abcdef",
+                "catalogo.prioridad.renombrada",
+                Instant.parse("2026-11-24T21:14:00Z"),
+                2L,
+                "Alta",
+                "Crítica",
+                4
+        );
+        Set<ConstraintViolation<PrioridadRenombradaEvent>> violaciones = validator.validate(invalido);
+        assertEquals(1, violaciones.size());
+        assertEquals("eventId", violaciones.iterator().next().getPropertyPath().toString());
+    }
+}
