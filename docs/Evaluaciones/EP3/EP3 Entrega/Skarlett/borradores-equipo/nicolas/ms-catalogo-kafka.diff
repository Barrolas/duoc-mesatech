+
+import java.time.Instant;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+class PrioridadRenombradaKafkaListenerTest {
+
+    @Test
+    void confirmaOffsetSoloDespuesDeGuardar() {
+        AuditoriaPrioridadService service = mock(AuditoriaPrioridadService.class);
+        OperacionLogService logService = new OperacionLogService(JsonMapper.builder().build());
+        Acknowledgment ack = mock(Acknowledgment.class);
+
+        AuditoriaPrioridad guardada = new AuditoriaPrioridad();
+        guardada.setTipoCambio(AuditoriaPrioridadService.CAMBIO_SUSTANTIVO);
+        when(service.registrarRenombre(any(), anyString(), anyInt(), anyLong(), anyString()))
+                .thenReturn(Optional.of(guardada));
+
+        PrioridadRenombradaKafkaListener listener =
+                new PrioridadRenombradaKafkaListener(service, logService, "mesatech-catalogo-kafka");
+        PrioridadRenombradaEvent ev = new PrioridadRenombradaEvent(
+                "e6f7a8b9-0123-4cde-a012-3456789abcde",
+                PrioridadRenombradaEvent.TIPO,
+                Instant.parse("2026-11-24T21:14:00Z"),
+                2L,
+                "Alta",
+                "Crítica operacional",
+                4
+        );
+
+        listener.onPrioridadRenombrada(ev, "mesatech.catalogo.prioridad", 2, 0L, "prioridad-2", ack);
+        verify(ack).acknowledge();
+    }
+
+    @Test
+    void noConfirmaOffsetSiFallaPersistencia() {
+        AuditoriaPrioridadService service = mock(AuditoriaPrioridadService.class);
+        OperacionLogService logService = new OperacionLogService(JsonMapper.builder().build());
+        Acknowledgment ack = mock(Acknowledgment.class);
+
+        when(service.registrarRenombre(any(), anyString(), anyInt(), anyLong(), anyString()))
+                .thenThrow(new RuntimeException("rds down"));
+
+        PrioridadRenombradaKafkaListener listener =
+                new PrioridadRenombradaKafkaListener(service, logService, "mesatech-catalogo-kafka");
+        PrioridadRenombradaEvent ev = new PrioridadRenombradaEvent(
+                "e6f7a8b9-0123-4cde-a012-3456789abcde",
+                PrioridadRenombradaEvent.TIPO,
+                Instant.parse("2026-11-24T21:14:00Z"),
+                2L,
+                "Alta",
+                "Crítica operacional",
+                4
+        );
+
+        assertThrows(RuntimeException.class,
+                () -> listener.onPrioridadRenombrada(ev, "mesatech.catalogo.prioridad", 2, 0L, "prioridad-2", ack));
+        verify(ack, never()).acknowledge();
+    }
+}
