+package cl.duoc.mesatech.catalogo.messaging.kafka;
+
+import cl.duoc.mesatech.catalogo.domain.Prioridad;
+import org.apache.kafka.clients.producer.RecordMetadata;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.stereotype.Component;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.time.Instant;
+import java.util.UUID;
+
+@Component
+public class PrioridadKafkaProducer {
+
+    private static final Logger log = LoggerFactory.getLogger(PrioridadKafkaProducer.class);
+
+    private final KafkaTemplate<Object, Object> kafkaTemplate;
+    private final JsonMapper jsonMapper;
+    private final OperacionLogService operacionLog;
+    private final String topicPrioridad;
+    private final String groupId;
+
+    public PrioridadKafkaProducer(
+            KafkaTemplate<Object, Object> kafkaTemplate,
+            JsonMapper jsonMapper,
+            OperacionLogService operacionLog,
+            @Value("${mesatech.kafka.topics.catalogo-prioridad}") String topicPrioridad,
+            @Value("${spring.kafka.consumer.group-id}") String groupId
+    ) {
+        this.kafkaTemplate = kafkaTemplate;
+        this.jsonMapper = jsonMapper;
+        this.operacionLog = operacionLog;
+        this.topicPrioridad = topicPrioridad;
+        this.groupId = groupId;
+    }
+
+    public String publicarPrioridadRenombrada(String nombreAnterior, Prioridad prioridadActualizada) {
+        String eventId = UUID.randomUUID().toString();
+        String key = "prioridad-" + prioridadActualizada.getId();
+        PrioridadRenombradaEvent evento = new PrioridadRenombradaEvent(
+                eventId,
+                PrioridadRenombradaEvent.TIPO,
+                Instant.now(),
+                prioridadActualizada.getId(),
+                nombreAnterior,
+                prioridadActualizada.getNombre(),
+                prioridadActualizada.getNivel()
+        );
+        try {
+            String json = jsonMapper.writeValueAsString(evento);
+            kafkaTemplate.send(topicPrioridad, key, json).whenComplete((result, ex) -> {
+                if (ex != null) {
+                    log.error("Error enviando evento {} a {} key={}: {}", eventId, topicPrioridad, key, ex.getMessage());
+                    operacionLog.registrar(
+                            "ERROR",
+                            groupId,
+                            topicPrioridad,
+                            null,
+                            null,
+                            key,
+                            eventId,
+                            "PRODUCTOR_FALLO_ENVIO",
+                            ex.getMessage()
+                    );
+                    return;
+                }
+                RecordMetadata meta = result != null ? result.getRecordMetadata() : null;
+                Integer partition = meta != null ? meta.partition() : null;
+                Long offset = meta != null ? meta.offset() : null;
+                operacionLog.registrar(
+                        "INFO",
+                        groupId,
+                        topicPrioridad,
+                        partition,
+                        offset,
+                        key,
+                        eventId,
+                        "PRODUCTOR_ENVIADO_ACK",
+                        null
+                );
+            });
+        } catch (Exception ex) {
+            log.error("No se pudo serializar o encolar evento {} para {}: {}", eventId, topicPrioridad, ex.getMessage());
+            operacionLog.registrar(
+                    "ERROR",
+                    groupId,
+                    topicPrioridad,
+                    null,
+                    null,
+                    key,
+                    eventId,
+                    "PRODUCTOR_ERROR_SERIALIZACION",
+                    ex.getMessage()
+            );
+        }
+        return eventId;
+    }
+}
