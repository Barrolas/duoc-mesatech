+package cl.duoc.mesatech.catalogo.messaging.kafka;
+
+import cl.duoc.mesatech.catalogo.domain.AuditoriaPrioridad;
+import cl.duoc.mesatech.catalogo.messaging.EventoInvalidoException;
+import cl.duoc.mesatech.catalogo.repo.AuditoriaPrioridadRepository;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.Instant;
+import java.util.Optional;
+
+@Service
+public class AuditoriaPrioridadService {
+
+    public static final String CAMBIO_FORMATO = "CORRECCION_FORMATO";
+    public static final String CAMBIO_SUSTANTIVO = "REVISION_SUSTANTIVA";
+
+    private final AuditoriaPrioridadRepository auditoriaRepo;
+
+    public AuditoriaPrioridadService(AuditoriaPrioridadRepository auditoriaRepo) {
+        this.auditoriaRepo = auditoriaRepo;
+    }
+
+    @Transactional
+    public Optional<AuditoriaPrioridad> registrarRenombre(
+            PrioridadRenombradaEvent evento,
+            String topico,
+            int particion,
+            long offset,
+            String key
+    ) {
+        if (evento == null) {
+            throw new EventoInvalidoException("El evento de prioridad renombrada viene nulo");
+        }
+        if (auditoriaRepo.existsByEventId(evento.eventId())) {
+            return Optional.empty();
+        }
+        if (evento.nombreAnterior().equals(evento.nombreNuevo())) {
+            throw new EventoInvalidoException("nombreNuevo debe ser distinto de nombreAnterior");
+        }
+
+        String anteriorNorm = normalizar(evento.nombreAnterior());
+        String nuevoNorm = normalizar(evento.nombreNuevo());
+        String tipoCambio = anteriorNorm.equalsIgnoreCase(nuevoNorm)
+                ? CAMBIO_FORMATO
+                : CAMBIO_SUSTANTIVO;
+
+        AuditoriaPrioridad registro = new AuditoriaPrioridad();
+        registro.setEventId(evento.eventId());
+        registro.setPrioridadId(evento.prioridadId());
+        registro.setNombreAnterior(evento.nombreAnterior());
+        registro.setNombreNuevo(evento.nombreNuevo());
+        registro.setNivel(evento.nivel());
+        registro.setTipoCambio(tipoCambio);
+        registro.setTopico(topico);
+        registro.setParticion(particion);
+        registro.setOffsetKafka(offset);
+        registro.setEventoKey(key);
+        registro.setFechaEvento(evento.fechaEvento());
+        registro.setProcesadoEn(Instant.now());
+
+        return Optional.of(auditoriaRepo.save(registro));
+    }
+
+    static String normalizar(String texto) {
+        return texto == null ? "" : texto.trim().replaceAll("\\s+", " ");
+    }
+}
