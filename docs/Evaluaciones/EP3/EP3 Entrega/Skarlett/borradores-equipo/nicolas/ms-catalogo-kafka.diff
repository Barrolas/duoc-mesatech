+package cl.duoc.mesatech.catalogo.messaging.kafka;
+
+import jakarta.validation.Valid;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.kafka.annotation.KafkaListener;
+import org.springframework.kafka.support.Acknowledgment;
+import org.springframework.kafka.support.KafkaHeaders;
+import org.springframework.messaging.handler.annotation.Header;
+import org.springframework.messaging.handler.annotation.Payload;
+import org.springframework.stereotype.Component;
+
+@Component
+public class PrioridadRenombradaKafkaListener {
+
+    private final AuditoriaPrioridadService auditoriaService;
+    private final OperacionLogService operacionLog;
+    private final String groupId;
+
+    public PrioridadRenombradaKafkaListener(
+            AuditoriaPrioridadService auditoriaService,
+            OperacionLogService operacionLog,
+            @Value("${spring.kafka.consumer.group-id}") String groupId
+    ) {
+        this.auditoriaService = auditoriaService;
+        this.operacionLog = operacionLog;
+        this.groupId = groupId;
+    }
+
+    @KafkaListener(
+            id = "prioridadRenombradaListener",
+            topics = "${mesatech.kafka.topics.catalogo-prioridad}",
+            groupId = "${spring.kafka.consumer.group-id}",
+            concurrency = "${mesatech.kafka.listener.concurrency:3}"
+    )
+    public void onPrioridadRenombrada(
+            @Payload @Valid PrioridadRenombradaEvent evento,
+            @Header(KafkaHeaders.RECEIVED_TOPIC) String topico,
+            @Header(KafkaHeaders.RECEIVED_PARTITION) int particion,
+            @Header(KafkaHeaders.OFFSET) long offset,
+            @Header(value = KafkaHeaders.RECEIVED_KEY, required = false) String key,
+            Acknowledgment acknowledgment
+    ) {
+        var guardado = auditoriaService.registrarRenombre(evento, topico, particion, offset, key);
+        acknowledgment.acknowledge();
+
+        String resultado = guardado
+                .map(a -> "CONSUMIDO_GUARDADO_" + a.getTipoCambio())
+                .orElse("IGNORADO_DUPLICADO_IDEMPOTENTE");
+        operacionLog.registrar(
+                "INFO",
+                groupId,
+                topico,
+                particion,
+                offset,
+                key,
+                evento.eventId(),
+                resultado,
+                "prioridadId=" + evento.prioridadId()
+        );
+    }
+}
